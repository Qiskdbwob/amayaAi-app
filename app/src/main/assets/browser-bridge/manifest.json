{
  "manifest_version": 2,
  "name": "Amaya Browser Bridge",
  "version": "1.4",
  "browser_specific_settings": { "gecko": { "id": "browser-bridge@amaya.local" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["bridge.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
