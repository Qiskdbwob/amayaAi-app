<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark variant — windowBackground matches Compose dark background (#1E1E1E) -->
    <style name="Theme.Amaya" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
    </style>

    <!-- Dark variant of the launch theme — same flower, dark flat background. -->
    <style name="Theme.Amaya.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_flower</item>
        <item name="postSplashScreenTheme">@style/Theme.Amaya</item>
    </style>
</resources>
