<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Only non-secret SharedPreferences are portable. DataStore, Room, sessions,
         skills, references, and workspace memory remain device-local. -->
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="amaya_secure_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_value_keyset__.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="amaya_secure_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_value_keyset__.xml" />
    </device-transfer>
</data-extraction-rules>
