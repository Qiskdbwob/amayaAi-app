<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Custom endpoints may use HTTP on loopback or private LAN addresses.
         ProviderModelService rejects public HTTP URLs before requests are made. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
